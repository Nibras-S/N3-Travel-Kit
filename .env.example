# Browser-safe Clerk publishable key only.
VITE_CLERK_PUBLISHABLE_KEY=

# Existing Clerk configuration stays separate from Neon storage/database auth.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Generated by neon deploy / neon env pull. Keep these server-only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The private logo bucket is declared as "uploads" in neon.ts.
PORT=3001
